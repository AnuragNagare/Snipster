# One file, two places it is used:
#   • On Vercel  — add the variables marked [API] in Project Settings > Environment Variables.
#   • On your PC — copy this to backend/.env for the worker (and for running the API locally).
# Both must point at the SAME database, Redis and storage bucket.

# ─── Database  [API + worker] ────────────────────────────────────────────────
# Neon (create it from the Vercel Marketplace and the variable is added for you).
# Paste the string exactly as Neon gives it — postgresql://… with ?sslmode=require is fine.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Redis  [API + worker] ───────────────────────────────────────────────────
# The API puts jobs on this queue; the worker on your PC takes them off.
# Hosted Redis over TLS looks like rediss://default:password@host:port (note the double s).
# Prefer a plan with a fixed price: the worker polls constantly, which a pay-per-command
# plan counts command by command.
REDIS_URL=rediss://default:password@your-host.example.com:6379

# ─── Cloudflare R2 (S3-compatible)  [API + worker] ───────────────────────────
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=snipster
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public bucket URL (enable public access on bucket in R2 dashboard)
STORAGE_PUBLIC_BASE_URL=https://pub-<TOKEN>.r2.dev
# Largest video accepted by the direct upload, in MB.
MAX_UPLOAD_MB=4096

# ─── Login  [API] ────────────────────────────────────────────────────────────
# REQUIRED on Vercel: without ADMIN_PASSWORD the deployed API refuses every request,
# because the URL is public. Locally you can leave it blank for no login.
ADMIN_PASSWORD=
# Signs login tokens. Required (32+ random characters) whenever ADMIN_PASSWORD is set:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-in-production

# ─── Google OAuth (YouTube)  [API] ───────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Scopes needed: https://www.googleapis.com/auth/youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel this must be your deployed address, and the SAME address must be added to the
# OAuth client's "Authorized redirect URIs" in Google Cloud:
#   https://<your-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── App  [API] ──────────────────────────────────────────────────────────────
# Where Google sends the browser back to after sign-in. On Vercel: https://<your-domain>
FRONTEND_URL=http://localhost:5173
# Only if the UI is served from a different address than the API (not needed on Vercel).
CORS_ORIGINS=

# Token encryption key (32 url-safe base64 chars) — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# [API + worker] — the API encrypts the YouTube token, the worker decrypts it to publish.
# Never change it once set: every saved token becomes unreadable.
TOKEN_ENCRYPTION_KEY=

# ─── Gemini  [worker only] ───────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Performance  [worker only] ──────────────────────────────────────────────
# Whisper. "auto" uses the GPU (cuda + float16) when one is visible, else
# cpu + int8. Set WHISPER_DEVICE=cpu to force CPU.
# GPU transcription needs CUDA 12's cuBLAS — that is the nvidia-cublas-cu12 pin
# in requirements-worker.txt, not a CUDA toolkit install. If it is missing, the service
# logs "GPU unusable" and falls back to CPU rather than failing the task.
# Must be a multilingual model for Hindi (base.en is English-only). "medium" fits a 6 GB GPU
# with WHISPER_COMPUTE_TYPE=int8_float16; "large-v3" is better but tight on 6 GB.
WHISPER_MODEL=medium
# Empty = auto-detect the spoken language. Or force one: hi, en, ...
WHISPER_LANGUAGE=
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true

# Font for burned-in Hindi subtitles. Must be installed on the worker PC
# (Nirmala UI ships with Windows; on Linux use "Noto Sans Devanagari").
SUBTITLE_FONT_DEVANAGARI=Nirmala UI

# ffmpeg encoder. "auto" uses h264_nvenc when the build supports it.
# Set FFMPEG_ENCODER=libx264 to force software encoding.
FFMPEG_ENCODER=auto

# Local cache so each clip render doesn't re-download the source from R2.
# "auto" = system temp dir. Leave empty to disable caching.
MEDIA_CACHE_DIR=auto
MEDIA_CACHE_MAX_AGE_HOURS=6

# Cap the resolution yt-dlp fetches — output is 1080x1920. 0 disables the cap.
MAX_SOURCE_HEIGHT=1080

# ─── Autopilot  [worker only] ────────────────────────────────────────────────
# Lists the connected channel's public uploads. Create at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# The worker refreshes the YouTube sign-in itself, so it needs the Google client id and secret too
# (copy GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from the API's settings into the worker's .env).
AUTOPILOT_TICK_MINUTES=5
AUTOPILOT_MIN_DURATION=180
AUTOPILOT_MAX_DURATION=3600
AUTOPILOT_MAX_PAGES=10

# Telegram alerts: failed posts, failed videos, autopilot errors.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dead-man's switch (healthchecks.io or similar). Pinged after every healthy autopilot tick;
# the service alerts you when pings stop, e.g. when the PC is off. Set its period to about
# 10 minutes and its grace time to an hour or more: a long transcription delays ticks.
HEALTHCHECK_URL=
